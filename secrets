#!/bin/bash

if [[ ! $OP_ENV ]]; then
    OP_ENV="dev"
fi

export OP_ACCOUNT="my.1password.com"
export OP_ENV=$OP_ENV

echo "Loading $OP_ENV secrets"

TEMP_ENV_FILE=$(mktemp)

echo $TEMP_ENV_FILE
op inject -i .env -o $TEMP_ENV_FILE -f >/dev/null 2>&1

# Replace double-quoted strings by single-quoted, to ensure secrets containing symbols such as '$' are also loaded correctly.
# Uses a second temp file, to avoid race conditions
TEMP_PARSED_ENV_FILE=$(mktemp)
echo "$(cat "$TEMP_ENV_FILE")" | sed "s/\"/'/g" >"$TEMP_PARSED_ENV_FILE"

. $TEMP_PARSED_ENV_FILE

rm -rf $TEMP_ENV_FILE
rm -rf $TEMP_PARSED_ENV_FILE
